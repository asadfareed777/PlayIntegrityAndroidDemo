# Copy to .env (or set real environment variables) — server/src/config.js reads process.env.

PORT=8080
NODE_ENV=development

# "google" = real decode via playintegrity.googleapis.com, "mock" = local testing only (refused in production)
INTEGRITY_MODE=google

# Service account JSON key with access to the Play Integrity API of the linked Cloud project.
# Alternatively rely on Application Default Credentials (Cloud Run / GKE workload identity).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Must equal the app's applicationId.
EXPECTED_PACKAGE_NAME=com.example.playintegrity

# Play App Signing certificate SHA-256 (Play Console > Test and release > App integrity > App signing).
# Comma-separated. Colon-hex (AA:BB:...) or base64url both accepted. Add the upload key too if you sideload upload-signed builds.
ALLOWED_CERT_DIGESTS=

# Comma-separated accepted appRecognitionVerdict values. Keep PLAY_RECOGNIZED only in production.
ALLOWED_APP_VERDICTS=PLAY_RECOGNIZED

# Device label that must be present in deviceRecognitionVerdict.
REQUIRED_DEVICE_VERDICT=MEETS_DEVICE_INTEGRITY

# true = require accountDetails.appLicensingVerdict == LICENSED
REQUIRE_LICENSING=false

# Token freshness window and tolerated clock skew (ms).
MAX_TOKEN_AGE_MS=120000
MAX_CLOCK_SKEW_MS=10000

# Per-IP rate limit.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Sensitive configuration returned on success (JSON object of string values). Load from a secret manager in production.
SENSITIVE_CONFIG_JSON={"nativeApiKey":"demo-native-key","nativeEndpoint":"https://api.example.com","nativeFeatureSalt":"demo-salt","featureFlags":"payments,premium"}
CONFIG_TTL_SECONDS=3600
CONFIG_CACHEABLE=true

# Set when running behind a load balancer / reverse proxy so req.ip is the client IP.
TRUST_PROXY=false
